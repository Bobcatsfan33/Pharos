{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getpharos.dev/schemas/pdp-v1.0.0.json",
  "title": "Pharos PDP wire contract",
  "description": "Generated from packages/pdp-spec/src/schema.ts. Objects accept additional properties: the contract is additive, and readers must ignore fields they do not know.",
  "version": "1.0.0",
  "$defs": {
    "Decision": { "type": "string", "enum": ["allow", "block", "modify", "escalate"] },
    "Reversibility": { "type": "string", "enum": ["reversible", "irreversible"] },
    "OversightMode": { "type": "string", "enum": ["autonomous", "human_in_loop", "human_on_loop"] },
    "FailMode": {
      "anyOf": [{ "type": "string", "enum": ["fail_open", "fail_closed"] }, { "type": "null" }]
    },
    "TierReached": {
      "anyOf": [
        { "type": "number", "const": 1 },
        { "type": "number", "const": 2 },
        { "type": "number", "const": 3 },
        { "type": "string", "const": "human" }
      ]
    },
    "SignatureAlgorithm": { "type": "string", "enum": ["ed25519", "ecdsa-p256"] },
    "RuleCitation": {
      "type": "object",
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "pack": { "type": "string", "minLength": 1 },
        "clause": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["ruleId", "pack"]
    },
    "ModelMetadata": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["provider", "model"]
    },
    "BlastRadiusInput": {
      "type": "object",
      "properties": {
        "financialAmount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string" },
        "reversibility": { "$ref": "#/$defs/Reversibility" },
        "notes": { "type": "string" }
      },
      "required": ["reversibility"]
    },
    "MandateInput": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "limits": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {}
        },
        "grantor": { "type": "string" },
        "expiresAt": { "type": ["string", "null"] },
        "version": { "type": "string" }
      },
      "required": ["id", "scope", "grantor"]
    },
    "ActionInput": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string" },
        "payload": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {}
        }
      },
      "required": ["type", "agentId"]
    },
    "LiabilityInput": {
      "type": "object",
      "properties": {
        "mandate": { "anyOf": [{ "$ref": "#/$defs/MandateInput" }, { "type": "null" }] },
        "oversightMode": { "$ref": "#/$defs/OversightMode" },
        "blastRadius": { "$ref": "#/$defs/BlastRadiusInput" },
        "modelMetadata": { "anyOf": [{ "$ref": "#/$defs/ModelMetadata" }, { "type": "null" }] }
      },
      "required": ["oversightMode", "blastRadius"]
    },
    "VerdictLatency": {
      "type": "object",
      "properties": {
        "totalMs": { "type": "number", "minimum": 0 },
        "perTier": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "deadlineMs": { "type": "number", "exclusiveMinimum": 0 },
        "deadlineBreached": { "type": "boolean" }
      },
      "required": ["totalMs", "deadlineMs", "deadlineBreached"]
    },
    "Verdict": {
      "type": "object",
      "properties": {
        "decision": { "$ref": "#/$defs/Decision" },
        "tierReached": { "$ref": "#/$defs/TierReached" },
        "riskScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "ruleCitations": { "type": "array", "items": { "$ref": "#/$defs/RuleCitation" } },
        "failMode": { "$ref": "#/$defs/FailMode" },
        "judgeVersion": { "type": ["string", "null"] },
        "latency": { "$ref": "#/$defs/VerdictLatency" }
      },
      "required": [
        "decision",
        "tierReached",
        "riskScore",
        "ruleCitations",
        "failMode",
        "judgeVersion",
        "latency"
      ]
    },
    "PdpRequest": {
      "type": "object",
      "properties": {
        "action": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "agentId": { "type": "string", "minLength": 1 },
            "payload": {
              "type": "object",
              "propertyNames": { "type": "string" },
              "additionalProperties": {}
            }
          },
          "required": ["type", "agentId"]
        },
        "liability": {
          "type": "object",
          "properties": {
            "mandate": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "limits": {
                      "type": "object",
                      "propertyNames": { "type": "string" },
                      "additionalProperties": {}
                    }
                  },
                  "required": ["id"]
                },
                { "type": "null" }
              ]
            },
            "oversightMode": { "$ref": "#/$defs/OversightMode" },
            "blastRadius": { "$ref": "#/$defs/BlastRadiusInput" }
          },
          "required": ["oversightMode", "blastRadius"]
        },
        "deadlineMs": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["action", "liability"]
    },
    "PdpEvidenceBinding": {
      "type": "object",
      "properties": {
        "algorithm": { "$ref": "#/$defs/SignatureAlgorithm" },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "keyId": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 }
      },
      "required": ["algorithm", "contentHash", "keyId", "signature"]
    },
    "PdpResponse": {
      "type": "object",
      "properties": {
        "specVersion": { "type": "string", "const": "1.0.0" },
        "decision": { "$ref": "#/$defs/Decision" },
        "tierReached": { "$ref": "#/$defs/TierReached" },
        "riskScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "ruleCitations": { "type": "array", "items": { "$ref": "#/$defs/RuleCitation" } },
        "failMode": { "$ref": "#/$defs/FailMode" },
        "judgeVersion": { "type": ["string", "null"] },
        "latency": {
          "type": "object",
          "properties": {
            "totalMs": { "type": "number", "minimum": 0 },
            "deadlineMs": { "type": "number", "exclusiveMinimum": 0 },
            "deadlineBreached": { "type": "boolean" }
          },
          "required": ["totalMs", "deadlineMs", "deadlineBreached"]
        },
        "evidenceBinding": { "$ref": "#/$defs/PdpEvidenceBinding" }
      },
      "required": [
        "specVersion",
        "decision",
        "tierReached",
        "riskScore",
        "ruleCitations",
        "failMode",
        "judgeVersion",
        "latency"
      ]
    }
  }
}
