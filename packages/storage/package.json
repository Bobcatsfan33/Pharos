{
  "name": "@pharos/storage",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./postgres": {
      "types": "./src/postgresBackend.ts",
      "import": "./src/postgresBackend.ts"
    },
    "./embedded": {
      "types": "./src/embedded/backend.ts",
      "import": "./src/embedded/backend.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@pharos/core": "workspace:*",
    "@pharos/identity": "workspace:*",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  },
  "sideEffects": false
}
