# Editor defaults that match .prettierrc.json, so an editor saving a file and `pnpm format`
# agree. Prettier is a blocking CI gate, so a mismatch here shows up as a failed build.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Prettier formats Markdown but keeps trailing whitespace significant: two spaces at the end
# of a line is a hard break. Trimming it on save would silently rewrite the rendered output.
[*.md]
trim_trailing_whitespace = false

# Python: ruff is configured with line-length = 100 (runtime/python/pyproject.toml), matching
# prettier's printWidth, so the same number applies here.
[*.py]
max_line_length = 100

# Makefiles require real tabs.
[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
