{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "replicaCount", "secretName", "gateway", "config", "judgeModelCache"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 2
    },
    "secretName": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": [
        "enabled",
        "replicaCount",
        "port",
        "tenantId",
        "agentId",
        "target",
        "apiBase",
        "verdictDeadlineMs",
        "secretName",
        "autoscaling",
        "networkPolicy"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 2 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tenantId": { "type": "string" },
        "agentId": { "type": "string" },
        "target": {
          "type": "string",
          "pattern": "^$|^https?://\\S+$"
        },
        "apiBase": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "verdictDeadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "secretName": { "type": "string" },
        "autoscaling": {
          "type": "object",
          "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 2 },
            "maxReplicas": { "type": "integer", "minimum": 2 },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "required": ["enabled", "ingressPodSelector", "dns", "target", "database"],
          "properties": {
            "enabled": { "type": "boolean" },
            "ingressPodSelector": { "type": "object" },
            "dns": { "$ref": "#/definitions/selectorDestination" },
            "target": { "$ref": "#/definitions/egressDestination" },
            "database": { "$ref": "#/definitions/egressDestination" }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "env",
        "kmsProvider",
        "kmsAwsRegion",
        "tsaProvider",
        "tsaUrl",
        "tsaCertSha256",
        "judgeProvider",
        "judgeModelDir"
      ],
      "properties": {
        "env": {
          "type": "string",
          "enum": ["local", "dev", "staging", "prod"]
        },
        "kmsProvider": {
          "type": "string",
          "enum": ["local-kms", "aws-kms"]
        },
        "kmsAwsRegion": { "type": "string", "minLength": 1 },
        "tsaProvider": {
          "type": "string",
          "enum": ["local", "rfc3161"]
        },
        "tsaUrl": { "type": "string" },
        "tsaCertSha256": {
          "type": "string",
          "pattern": "^$|^[a-fA-F0-9]{64}(,[a-fA-F0-9]{64})*$"
        },
        "judgeProvider": {
          "type": "string",
          "enum": ["linear", "onnx"]
        },
        "judgeModelDir": { "type": "string", "minLength": 1 }
      }
    },
    "judgeModelCache": {
      "type": "object",
      "required": ["existingClaim", "sizeLimit"],
      "properties": {
        "existingClaim": { "type": "string" },
        "sizeLimit": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        }
      }
    }
  },
  "definitions": {
    "selectorDestination": {
      "type": "object",
      "required": ["port", "namespaceSelector", "podSelector"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "namespaceSelector": { "type": "object", "minProperties": 1 },
        "podSelector": { "type": "object", "minProperties": 1 }
      }
    },
    "judgeDriftProfile": {
      "type": "object",
      "required": ["existingConfigMap"],
      "properties": {
        "existingConfigMap": {
          "type": "string"
        }
      }
    },
    "egressDestination": {
      "type": "object",
      "required": ["port", "cidrs", "namespaceSelector", "podSelector"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]+$"
          }
        },
        "namespaceSelector": { "type": "object" },
        "podSelector": { "type": "object" }
      }
    }
  }
}
