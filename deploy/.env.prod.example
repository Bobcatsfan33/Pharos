# Pharos customer-hosted production inputs. Copy to .env.prod and set EVERY placeholder.
PHAROS_PG_URL=postgres://pharos@postgres.example/pharos?sslmode=verify-full
PHAROS_REDIS_URL=rediss://redis.example:6379
PHAROS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
PHAROS_S3_REGION=us-east-1
PHAROS_S3_BUCKET=pharos-evidence
PHAROS_S3_FORCE_PATH_STYLE=false
PHAROS_KMS_PROVIDER=aws-kms
PHAROS_KMS_AWS_REGION=us-east-1
PHAROS_TSA_PROVIDER=rfc3161
PHAROS_TSA_URL=https://your-contracted-tsa.example/tsr
# Obtain this out-of-band from the contracted TSA. Add the next pin comma-separated during rotation.
PHAROS_TSA_CERT_SHA256=replace-with-64-character-approved-leaf-certificate-sha256
PHAROS_JUDGE_PROVIDER=onnx
PHAROS_JUDGE_MODEL_DIR=/var/lib/pharos/judges
PHAROS_ADMIN_TOKEN=change-me-bootstrap-token
PHAROS_API_PORT=4000
PHAROS_ALLOWED_ORIGINS=https://console.your-domain.example
PHAROS_IMAGE=ghcr.io/bobcatsfan33/pharos-api@sha256:replace-with-verified-digest
