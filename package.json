{
  "name": "pharos",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Pharos \u2014 the trust control plane for enterprise AI agents. Pharos decides. Pharos proves.",
  "type": "module",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./services/* build",
    "build:publishable": "pnpm --filter @getpharos/sdk --filter @getpharos/middleware --filter @getpharos/pdp-spec build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm runtime:check",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:judge-parity": "vitest run test/onnx-serving.spec.ts --config vitest.live.config.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "runtime:install": "python3 -m pip install -e 'runtime/python[dev,viewer,pg,otel]'",
    "runtime:lint": "python3 -m ruff check runtime/python",
    "runtime:typecheck": "cd runtime/python && python3 -m mypy keel pharos_runtime",
    "runtime:test": "cd runtime/python && python3 -m pytest -q",
    "runtime:architecture": "cd runtime/python && lint-imports",
    "runtime:check": "pnpm runtime:lint && pnpm runtime:typecheck && pnpm runtime:architecture && pnpm runtime:test",
    "runtime:e2e": "tsx scripts/e2e-runtime.ts",
    "pharos:workbench": "tsx scripts/pharos-workbench.ts",
    "demo:durability": "tsx --env-file=.env scripts/demo-durability.ts",
    "demo": "tsx --env-file=.env scripts/demo.ts",
    "verify:external": "tsx --env-file=.env scripts/external-verify.ts",
    "verify:bundle": "tsx scripts/external-verify.ts --bundle",
    "api:dev": "tsx --env-file=.env services/api/src/server.ts",
    "gateway:rotate-held-keys": "tsx scripts/rotate-gateway-held-keys.ts",
    "judges:train": "tsx scripts/train-judges.ts",
    "judges:eval": "tsx scripts/eval-judges.ts",
    "judges:gate": "tsx scripts/eval-gate.ts",
    "judges:system-eval": "tsx scripts/system-eval.ts",
    "judges:drift-profile": "tsx scripts/build-judge-drift-profile.ts",
    "bench:latency": "tsx scripts/bench-latency.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "fastify": "^5.12.1",
    "globals": "^17.11.0",
    "jose": "^6.2.10",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@3": "^3.1.5",
      "fast-uri@4": "^4.1.2",
      "brace-expansion@4": "^5.0.9",
      "brace-expansion@5": "^5.0.9",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.17",
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18"
    }
  }
}
