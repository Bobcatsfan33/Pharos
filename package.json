{
  "name": "pharos",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Pharos \u2014 the trust control plane for enterprise AI agents. Pharos decides. Pharos proves.",
  "type": "module",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./services/* build",
    "build:publishable": "pnpm --filter @getpharos/sdk --filter @getpharos/middleware --filter @getpharos/pdp-spec build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:judge-parity": "vitest run test/onnx-serving.spec.ts --config vitest.live.config.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "demo:durability": "tsx --env-file=.env scripts/demo-durability.ts",
    "demo": "tsx --env-file=.env scripts/demo.ts",
    "verify:external": "tsx --env-file=.env scripts/external-verify.ts",
    "verify:bundle": "tsx scripts/external-verify.ts --bundle",
    "api:dev": "tsx --env-file=.env services/api/src/server.ts",
    "gateway:rotate-held-keys": "tsx scripts/rotate-gateway-held-keys.ts",
    "judges:train": "tsx scripts/train-judges.ts",
    "judges:eval": "tsx scripts/eval-judges.ts",
    "judges:gate": "tsx scripts/eval-gate.ts",
    "judges:system-eval": "tsx scripts/system-eval.ts",
    "judges:drift-profile": "tsx scripts/build-judge-drift-profile.ts",
    "bench:latency": "tsx scripts/bench-latency.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "fastify": "^5.11.3",
    "globals": "^15.15.0",
    "jose": "^6.2.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "8.2.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@3": "^3.1.5",
      "fast-uri@4": "^4.1.2",
      "brace-expansion@4": "^5.0.9",
      "brace-expansion@5": "^5.0.9",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.17",
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18"
    }
  }
}
