{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bobcatsfan33/Pharos/blob/main/docs/external-readiness/evidence-receipt.schema.json",
  "title": "Pharos external readiness evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gateId",
    "subject",
    "assessment",
    "assessor",
    "decision",
    "artifactRefs",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gateId": {
      "enum": [
        "ENG-JUDGES",
        "EXT-PENTEST",
        "EXT-TRUST",
        "EXT-OPERATIONS",
        "EXT-COMPLIANCE",
        "EXT-CUSTOMERS"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "const": "Bobcatsfan33/Pharos" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "imageDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "deploymentId": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "completedAt", "scope", "methodology", "limitations"],
      "properties": {
        "startedAt": { "type": "string", "format": "date" },
        "completedAt": { "type": "string", "format": "date" },
        "scope": { "type": "string", "minLength": 1 },
        "methodology": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role", "organization", "independentOfPreparer"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 },
        "independentOfPreparer": { "const": true }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "approvedBy", "exceptions"],
      "properties": {
        "result": { "const": "approved" },
        "approvedBy": { "$ref": "#/$defs/identity" },
        "exceptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "artifactRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "sha256", "classification", "retentionUntil"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "pattern": "^[a-z][a-z0-9+.-]*:.+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "classification": {
            "enum": ["public", "internal", "confidential", "restricted"]
          },
          "retentionUntil": { "type": "string", "format": "date" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "keyId", "value", "verificationInstructions"],
      "properties": {
        "scheme": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "verificationInstructions": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role", "organization"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 }
      }
    }
  }
}
