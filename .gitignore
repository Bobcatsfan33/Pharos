node_modules/
dist/
.next/
out/
*.tsbuildinfo
coverage/
.env
.env.local
*.log
.DS_Store
# Local signing keystores. The TSA keystore is a SEPARATE directory and was not
# covered by the narrower `.pharos-keystore/` rule — running `pnpm demo` creates it,
# so a contributor could have committed a private key. Glob covers both.
.pharos-keystore*/
.pharos-runtime/
.turbo/

.pharos-demo-auditor-key

# Python build/test artifacts (sdks/python)
build/
*.egg-info/
__pycache__/
.pytest_cache/
*.pyc

# Helm render artifacts from the CI helm job / local reproductions of it (#76).
rendered-*.yaml

# Demo artifacts (regenerated by `pnpm demo`)
evidence-bundle.json
.pharos-demo-auditor-key

# Produced by running the CLI inside the repo (`pnpm pharos init && pnpm pharos demo` from
# the root — the Codespaces on-ramp). `.pharos/` must stay this exact line: `pharos init`
# appends it to .gitignore when it is missing.
/pharos.yaml
.pharos/
