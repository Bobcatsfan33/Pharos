# Pharos environment configuration.
# Copy to .env for local development. All values below match docker-compose.yml.

# --- Deployment identity ---
PHAROS_ENV=local            # local | dev | staging | prod

# --- Postgres (operational state) ---
PHAROS_PG_URL=postgres://pharos:pharos_local_dev@localhost:5433/pharos
# Production: postgresql://.../pharos?sslmode=verify-full

# --- Redis (verdict cache) ---
PHAROS_REDIS_URL=redis://localhost:6380
# Production: rediss://redis.example.internal:6379

# --- S3-compatible WORM evidence store ---
PHAROS_S3_ENDPOINT=http://localhost:9010
PHAROS_S3_REGION=us-east-1
PHAROS_S3_BUCKET=pharos-evidence
PHAROS_S3_ACCESS_KEY=pharos
PHAROS_S3_SECRET_KEY=pharos_local_dev
PHAROS_S3_FORCE_PATH_STYLE=true
# Object Lock retention (days) applied to every sealed evidence object.
PHAROS_S3_WORM_RETENTION_DAYS=3650

# --- Signing keys (KMS) ---
# local-kms  -> Ed25519 keys in a local keystore (dev/test; default)
# aws-kms    -> AWS KMS asymmetric keys (ECC_NIST_P256 / ECDSA_SHA_256)
PHAROS_KMS_PROVIDER=local-kms
# Required for local-kms. Generate a unique secret (for example: `openssl rand -base64 32`) and
# source it from your OS keychain or local secret manager; losing it makes the keystore unreadable.
PHAROS_KMS_KEYSTORE_PASSPHRASE=replace-with-a-unique-random-secret
# Defaults to $XDG_DATA_HOME/pharos/keystore (or ~/.local/share/pharos/keystore), outside the repo.
# PHAROS_KMS_KEYSTORE_DIR=/secure/local/path/pharos/keystore
# aws-kms only: region + optional emulator endpoint. Credentials come from the standard AWS
# provider chain (env AWS_ACCESS_KEY_ID/SECRET, IAM role, SSO). Keys are created/rotated by
# Pharos under aliases alias/pharos/… (and alias/pharos-tsa/… for the timestamp authority).
PHAROS_KMS_AWS_REGION=us-east-1
# PHAROS_KMS_AWS_ENDPOINT=http://localhost:8088   # KMS emulator for local dev / CI

# --- Trusted-time authority (TSA) ---
# local    -> simulated TSA: a separate signing key stamps the time (hermetic; dev/test default)
# rfc3161  -> a real RFC 3161 TSA (the stored DER token verifies offline against the TSA cert)
PHAROS_TSA_PROVIDER=local
# rfc3161 only: the TSA endpoint. Production requires HTTPS.
# Example: https://timestamp.digicert.com
# PHAROS_TSA_URL=https://freetsa.org/tsr
# Scheduled anchoring interval (ms). Default 3600000 (hourly); set 0 to disable the scheduler.
# PHAROS_TSA_ANCHOR_INTERVAL_MS=3600000

# --- Tier-3 judge serving ---
# linear -> measured development baseline only
# onnx   -> hash-verified transformer artifacts; mandatory in production
PHAROS_JUDGE_PROVIDER=linear
# Writable content-addressed cache. Pre-stage the approved release assets here for restricted
# networks; every file is still verified against packages/judge/models/manifest.json at startup.
# PHAROS_JUDGE_MODEL_DIR=/var/lib/pharos/judges
# Production requires an independently approved, version-pinned drift reference profile.
# PHAROS_JUDGE_DRIFT_PROFILE_PATH=/etc/pharos/judge-drift/profile.json

# --- API service ---
PHAROS_API_PORT=4000
PHAROS_VERDICT_DEADLINE_MS=800
# Comma-separated allowed CORS origins. Empty = deny cross-origin browser calls.
PHAROS_ALLOWED_ORIGINS=http://localhost:3000
# Per-principal (tenant+subject) request budget per minute.
PHAROS_RATE_LIMIT_PER_MIN=600
# Per-tenant aggregate budget per minute, applied on top of the per-principal budget so a
# tenant cannot multiply its ingest budget by minting more API keys. Must be >= the
# per-principal budget.
PHAROS_RATE_LIMIT_TENANT_PER_MIN=6000
# Admission behavior when the rate-limit counter store is unreachable: "closed" refuses the
# request (503), "open" admits it unmetered. Production requires "closed" — degrading the
# cache must not remove the rate limit.
PHAROS_RATE_LIMIT_FAIL_MODE=closed

# --- Identity & access (Sprint 1: Gatehouse) ---
# Platform-operator bootstrap token for tenant provisioning (POST /v1/admin/tenants).
# Production requires at least 32 characters; source it from a secret manager.
PHAROS_ADMIN_TOKEN=local-admin-please-change
# Trusted OIDC issuers as a JSON array (Okta, Entra, ...). Empty disables SSO bearer auth.
# Production requires HTTPS issuer/JWKS URLs, one unique entry per issuer, and remote JWKS;
# inline signing keys are test-only.
# Example: [{"issuer":"https://acme.okta.com","audience":"pharos","jwksUri":"https://acme.okta.com/oauth2/v1/keys","claims":{"tenant":"pharos_tenant","roles":"pharos_roles"}}]
PHAROS_OIDC_ISSUERS=[]

# Production refuses to boot with local KMS, a KMS endpoint override, local
# timestamps, disabled anchoring, linear judges, a missing judge drift profile, plaintext object
# storage/Postgres/Redis, or a weak/missing administrative token. PostgreSQL
# must use sslmode=verify-ca or verify-full; encryption without certificate
# verification is not sufficient.
